{
  "name": "create-skip-service",
  "version": "1.3.1",
  "description": "CLI tool to create and initialize Skip services with customizable templates",
  "bin": {
    "create-skip-service": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "skip",
    "service",
    "template"
  ],
  "main": "dist/cli.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkipLabs/create-skip-service.git"
  },
  "bugs": {
    "url": "https://github.com/SkipLabs/create-skip-service/issues"
  },
  "homepage": "https://github.com/SkipLabs/create-skip-service#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "bun run lint-staged && bun run test:run",
    "pre-push": "bun run test:run && bun run typecheck"
  },
  "author": "SkipLabs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-sql": "^0.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1"
  },
  "lint-staged": {
    "**/*.{ts,js,mts}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
